generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EmissionFactor {
  id               String   @id @default(cuid())
  category         String
  value            Decimal  @db.Decimal(12, 6)
  numeratorUnit    String
  denominatorUnit  String
  scope            String
  sourceName       String
  sourceUrl        String?
  region           String
  publicationYear  Int
  methodologyNote  String
  isDemo           Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@unique([category, denominatorUnit, region, publicationYear, sourceName])
  @@index([category])
  @@index([scope])
  @@index([isDemo])
}
